doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Form
  link(rel='stylesheet' href='/style.css')
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css')
.position-1
  h1 Upload your video
  form(method='post' action='/form' enctype='multipart/form-data' id="form")
    .grid-container
      input.item(type='text' placeholder='Video Title' style='grid-area: item-1;' name="title" id="title")
      p.title-error
      input.item(type='text' placeholder='Description (optional)' style='grid-area: item-2; text-align: left; padding-top: 0px;' name="description" id="description")
      p.description-error
      select#quality.item(name='quality' style='grid-area: item-3;')
        option(value='' disabled='' selected='') Video quality
        option(value='360p') 360p
        option(value='480p') 480p
        option(value='720p') 720p
      input.item(type='date' placeholder='Date of Publishing' style='grid-area: item-4;' name="date" id="date")
      p.date-error
      label.item(style='grid-area: item-5;' id="video-label")
        input(type='file' accept='video/*' hidden name="video" id="video")
        span#video-placeholder
            i.fa.fa-cloud-upload(style='font-size:48px;color:grey')
            p Upload Video
        video#video-preview(hidden playsinline autoplay style='width:100%;height:100%;border-radius:10px;object-fit:cover;')
      label.item.dashed(style='grid-area: item-6;' id="image-label")
        input(type='file' accept='image/*' hidden name="image" id="image")
        span#image-placeholder
          i.fa.fa-cloud-upload(style='font-size:48px;color:#aaa')
          p Upload Thumbnail
        img#image-preview(hidden style='object-fit:cover; display: block')
      button.item.btn-1(style='grid-area: item-7;' type="submit") UPLOAD
      a.item.btn-1(href="/videos" style='grid-area: item-8; width: 90%; display: block; text-align: center; text-decoration: none') VIDEOS
script(src="/validation.js")